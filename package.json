{
  "name": "sucreia",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1 --port 3000",
    "build": "nuxt generate",
    "preview": "npx serve .output/public",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck && tsc -p tests/tsconfig.json && tsc -p server/tsconfig.json",
    "test": "node tests/all.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.ts",
    "start": "node --env-file-if-exists=.env server/index.ts --production",
    "backup": "node --env-file-if-exists=.env server/commands/backup.ts create",
    "restore": "node --env-file-if-exists=.env server/commands/backup.ts restore",
    "mail:check": "node --env-file-if-exists=.env server/commands/mail-check.ts",
    "admin": "node --env-file-if-exists=.env server/commands/admin.ts",
    "demo": "node server/commands/demo.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/qrcode": "1.5.5",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.14"
  },
  "dependencies": {
    "@fontsource/poppins": "5.3.0",
    "@lucide/vue": "1.73.0",
    "express": "5.3.0",
    "nodemailer": "8.0.10",
    "nuxt": "4.6.4",
    "qrcode": "1.5.4",
    "sharp": "0.35.5",
    "vue": "3.5.45",
    "vue-router": "5.5.1"
  },
  "allowScripts": {
    "esbuild": false
  }
}

{
  "name": "sucreia",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1 --port 3000",
    "build": "nuxt generate",
    "preview": "npx serve .output/public",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck && tsc -p tests/tsconfig.json",
    "test": "node tests/all.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.5",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.14"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jost": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/nunito-sans": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource-variable/work-sans": "5.3.0",
    "@fontsource/abril-fatface": "5.3.0",
    "@fontsource/archivo-black": "5.3.0",
    "@fontsource/young-serif": "5.3.0",
    "@lucide/vue": "1.73.0",
    "nuxt": "4.6.4",
    "vue": "3.5.45",
    "vue-router": "5.5.1"
  },
  "allowScripts": {
    "esbuild": false
  }
}

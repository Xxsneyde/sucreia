# Copia este archivo a .env para personalizar tu entorno. No subas .env a Git.
# npm run dev:api, npm start y comandos de mantenimiento lo leen si existe.
# Sin SMTP, desarrollo usa la bandeja local; producción no envía correos.
# PORT=4000
# HOST=127.0.0.1
# DATABASE_PATH=server/data/sucreia.db
# IMAGES_PATH=server/data/images
# PUBLIC_URL=https://tu-dominio.example
# SMTP_HOST=smtp.tu-proveedor.example
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=cuentas@tu-dominio.example
# COOKIE_SECURE=false  # Solo pruebas HTTP locales. En HTTPS debe ser true.

# IA opcional: modelo ya instalado en Ollama, en este equipo. Sin modelo se usa el catálogo.
# OLLAMA_MODEL=nombre-del-modelo-instalado
# OLLAMA_URL=http://127.0.0.1:11434

# --- Variables usadas en producción (Hostinger), recuperadas por nombre; los valores reales no están en el repo ---
# DATABASE_URL=postgres://usuario:clave@host:5432/base
# DATABASE_POOL=
# DATABASE_SSL=no-verify   # solo si hiciera falta; por defecto la conexión se verifica
# DATABASE_CA=             # certificado propio (los \n escritos se vuelven saltos de línea)
# STATIC_DIR=              # carpeta del sitio compilado (por defecto public/ junto a server.mjs)
# TRUST_PROXY=
# RESEND_API_KEY=
# MAIL_FROM=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# ONURIX_CLIENT=
# ONURIX_KEY=
